# ═══════════════════════════════════════════════════════════════════════════════
# Crypto Reconciliation Engine — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and configure values for your environment.
# All matching tolerances can be overridden per-request via the POST /reconcile body.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string (supports replica sets and Atlas URIs)
MONGODB_URI=mongodb://localhost:27017/crypto_reconciliation

# ── Matching Engine Tolerances ────────────────────────────────────────────────
# Maximum allowable timestamp difference (in seconds) for two transactions
# to be considered a potential match. Default: 300 (5 minutes).
TIMESTAMP_TOLERANCE_SECONDS=300

# Maximum allowable quantity difference (as a percentage) for two transactions
# to be considered a potential match. Default: 0.01 (0.01%).
QUANTITY_TOLERANCE_PCT=0.01

# ── Logging ───────────────────────────────────────────────────────────────────
# Supported levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
LOG_DIR=./logs

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP
RATE_LIMIT_MAX=100
